{
  "config": {
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false },
    "MD013": {
      "line_length": 80,
      "code_block_line_length": 120,
      "tables": false,
      "headings": false
    },
    "MD029": { "style": "ordered" }
  },
  // The canonical ignore set (concordat #168, the Markdown formatting
  // baseline). Every repository carries the same list so that a document
  // moved between them keeps the same lint status, and so that CI's globs
  // need no negations of their own.
  "ignores": [
    "**/.venv/**",
    ".vtcode/**",
    ".node_modules/**",
    "**/node_modules/**",
    "**/target/**",
    ".terraform/**",
    ".uv-cache/**",
    "memories/**",
    "CRUSH.md"
  ]
}
