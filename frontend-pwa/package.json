{
  "name": "@corbusier/frontend-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "audit": "bun run scripts/run-audit.mjs",
    "lint": "biome check .",
    "docs:check": "typedoc --options typedoc.json",
    "test:a11y": "vitest --run --config vitest.a11y.config.ts",
    "lint:classlist": "bun run scripts/check-classlist-length.ts",
    "lint:class-duplicates": "bun run scripts/find-near-duplicate-classes.ts",
    "lint:hardcoded-strings": "bun run scripts/check-hardcoded-strings.ts",
    "lint:locale-vars": "bun run scripts/check-locale-vars.ts",
    "localizability:lint": "bun run lint:hardcoded-strings && bun run lint:locale-vars",
    "semantic:lint": "bun run lint && bun run lint:classlist && bun run lint:class-duplicates && bun run lint:hardcoded-strings && uvx semgrep --config tools/semgrep-semantic.yml --include src/**/*.tsx --include tests/**/*.tsx && bunx stylelint 'src/**/*.css' --config tools/stylelint.config.cjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "overrides": {
    "@babel/core": "^7.29.1",
    "baseline-browser-mapping": "^2.11.0",
    "browserslist": "^4.29.0",
    "colord": "^2.9.4",
    "esbuild": "^0.28.1",
    "fast-uri": "3.1.8",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.23",
    "undici": "^7.29.1",
    "vite": "^7.3.6",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@testing-library/dom": "^10.4.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "axe-core": "^4.13.0",
    "daisyui": "^5.7.46",
    "jest-axe": "^10.0.0",
    "jsdom": "^30.1.1",
    "stylelint": "^17.15.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.11"
  }
}
